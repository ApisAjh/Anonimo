{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/css/(.*)",
      "dest": "public/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "public/js/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "public/images/$1"
    },
    {
      "src": "/u/(.*)",
      "dest": "public/profile.html"
    },
    {
      "src": "/dashboard",
      "dest": "public/dashboard.html"
    },
    {
      "src": "/settings",
      "dest": "public/settings.html"
    },
    {
      "src": "/premium",
      "dest": "public/premium.html"
    },
    {
      "src": "/login",
      "dest": "public/login.html"
    },
    {
      "src": "/register",
      "dest": "public/register.html"
    },
    {
      "src": "/forgot-password",
      "dest": "public/forgot-password.html"
    },
    {
      "src": "/reset-password",
      "dest": "public/reset-password.html"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ],
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
